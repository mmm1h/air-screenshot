#pragma code_page(65001) // UTF-8

#include "resource.h"
#include <winver.h>

IDI_APP_ICON ICON "app.ico"
IDR_LICENSE_TEXT RCDATA "../../LICENSE"
IDR_THIRD_PARTY_TEXT RCDATA "../../THIRD_PARTY_NOTICES.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AIRSHOT_VERSION_MAJOR,AIRSHOT_VERSION_MINOR,AIRSHOT_VERSION_PATCH,0
 PRODUCTVERSION AIRSHOT_VERSION_MAJOR,AIRSHOT_VERSION_MINOR,AIRSHOT_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Air Screenshot\0"
            VALUE "FileDescription", "Air Screenshot\0"
            VALUE "FileVersion", AIRSHOT_VERSION "\0"
            VALUE "InternalName", "AirScreenshot.exe\0"
            VALUE "OriginalFilename", "AirScreenshot.exe\0"
            VALUE "ProductName", "Air Screenshot\0"
            VALUE "ProductVersion", AIRSHOT_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
